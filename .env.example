# Copy to .env.local for local runs; set the same keys in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# --- App ---
APP_URL=https://aangan-studio.vercel.app          # used in transcript links inside emails
DASHBOARD_PASSWORD=                                # Nikhil's dashboard password
SESSION_SECRET=                                    # 32+ random chars: openssl rand -base64 32
CRON_SECRET=                                       # shared with Supabase pg_cron: openssl rand -hex 24

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://gktuqdynfxxqlndzllud.supabase.co
SUPABASE_SECRET_KEY=                               # sb_secret_… (server only; RLS blocks every other key)

# --- Vaani ---
VAANI_API_BASE=https://api.vaani.ai
VAANI_API_KEY=                                     # API token / JWT
VAANI_AGENT_NUMBER=                                # the studio number Vaani answers / dials from
VAANI_WEBHOOK_SECRET=                              # set the same value in Vaani's post-call webhook settings
VAANI_RATE_PER_MIN=6                               # ₹ per call minute, from your Vaani plan

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_INR_PER_1M_INPUT=25                         # ₹ per 1M input tokens
GEMINI_INR_PER_1M_OUTPUT=210                       # ₹ per 1M output (incl. thinking) tokens

# --- Google Calendar (OAuth client + refresh token for a studio account with edit access to every designer calendar) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Resend ---
RESEND_API_KEY=
RESEND_FROM=Aangan Studio <hello@your-verified-domain.in>
RESEND_INR_PER_EMAIL=0.08
ESCALATION_EMAIL=nikhil@your-domain.in

# --- HubSpot (private app token; scopes: crm.objects.contacts.read/write, crm.objects.deals.read/write, crm.schemas.deals.read/write, tasks) ---
HUBSPOT_TOKEN=
HUBSPOT_PIPELINE_ID=                               # printed by: npm run hubspot:setup
HUBSPOT_STAGE_QUALIFIED=
HUBSPOT_STAGE_HUMAN_REVIEW=
HUBSPOT_STAGE_REJECTED=
HUBSPOT_STAGE_ESCALATED=
HUBSPOT_STAGE_INCOMPLETE=
HUBSPOT_STAGE_NOT_ENQUIRY=
HUBSPOT_FRONT_DESK_OWNER_ID=                       # optional: assign callback tasks to this HubSpot user
