# Copy to .env.local for local runs; set the same keys in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# --- App ---
APP_URL=https://aangan-studio-beta.vercel.app     # used in transcript links inside emails
ENQUIRY_SECRET=                                    # for POST /api/enquiry from the website: openssl rand -hex 24

# --- Neon Postgres (added automatically when Neon is connected to the Vercel project) ---
DATABASE_URL=postgres://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# --- Vaani (app.vaanivoice.ai) ---
VAANI_API_KEY=                                     # Vaani dashboard → API Keys (starts vaani_)
VAANI_AGENT_ID=                                    # filled in by: npm run vaani:setup
VAANI_PHONE_NUMBER=                                # studio number in Vaani, E.164 e.g. +912012345678 (optional)
VAANI_OUTBOUND_NUMBER=                             # caller ID for callbacks, if different (optional)
VAANI_WEBHOOK_SECRET=                              # set the same value in Vaani's post-call webhook settings
VAANI_RATE_PER_MIN=6                               # ₹ per call minute, from your Vaani plan

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_INR_PER_1M_INPUT=25                         # ₹ per 1M input tokens
GEMINI_INR_PER_1M_OUTPUT=210                       # ₹ per 1M output (incl. thinking) tokens

# --- Google Calendar (OAuth client + refresh token for a studio account with edit access to every designer calendar) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Resend ---
RESEND_API_KEY=
RESEND_FROM=Aangan Studio <hello@your-verified-domain.in>   # leave unset to use Resend's test sender (onboarding@resend.dev)
DEMO_INBOX=                                        # demo: send every email here instead (must be your Resend sign-up email when using the test sender)
RESEND_INR_PER_EMAIL=0.08
ESCALATION_EMAIL=nikhil@your-domain.in
